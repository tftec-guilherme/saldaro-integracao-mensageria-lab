{
  "version": "2.0",
  "logging": {
    "applicationInsights": {
      "samplingSettings": {
        "isEnabled": false
      }
    },
    "logLevel": {
      "default": "Information"
    }
  },
  "extensions": {
    "http": {
      "routePrefix": "api"
    },
    "queues": {
      "messageEncoding": "base64",
      "maxPollingInterval": "00:00:01",
      "visibilityTimeout": "00:00:10",
      "maxDequeueCount": 5,
      "batchSize": 16
    }
  }
}
